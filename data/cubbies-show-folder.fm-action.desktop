[Desktop Entry]
Type=Action
Name=Show as a Folder Cubby on the Desktop
Tooltip=Show this folder as a live Folder Cubby on the Cubbies desktop
Icon=folder
Profiles=folder;
TargetContext=true
TargetLocation=false
TargetToolbar=false

[X-Action-Profile folder]
Name=Folder
Exec=cubbies --add-folder %F
MimeTypes=inode/directory;
SelectionCount==1
Schemes=file;
